<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvFormTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Nueva Tarea"
        android:textColor="#38BDF8"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/etTaskName"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="#334155"
        android:hint="Nombre de la tarea"
        android:textColor="#F8FAFC"
        android:textColorHint="#94A3B8"
        app:layout_constraintTop_toBottomOf="@id/tvFormTitle" />

    <EditText
        android:id="@+id/etTaskSubject"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#334155"
        android:hint="Curso o Materia"
        android:textColor="#F8FAFC"
        android:textColorHint="#94A3B8"
        app:layout_constraintTop_toBottomOf="@id/etTaskName" />

    <EditText
        android:id="@+id/etTaskDate"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#334155"
        android:hint="Fecha de entrega (ej. Mañana)"
        android:textColor="#F8FAFC"
        android:textColorHint="#94A3B8"
        app:layout_constraintTop_toBottomOf="@id/etTaskSubject" />

    <Button
        android:id="@+id/btnSaveTask"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="40dp"
        android:backgroundTint="#38BDF8"
        android:text="Guardar Tarea"
        android:textColor="#0F172A"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/etTaskDate" />

</androidx.constraintlayout.widget.ConstraintLayout>